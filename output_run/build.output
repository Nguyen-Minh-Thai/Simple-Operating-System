$ make clean && make all
mkdir -p obj
obj/cpu.o obj/mem.o obj/loader.o obj/queue.o obj/os.o obj/sched.o obj/timer.o obj/mm-vm.o obj/mm64.o obj/mm.o obj/mm-memphy.o obj/libstd.o obj/libmem.o obj/syscall.o obj/sys_mem.o obj/sys_listsyscall.o obj/sys_xxxhandler.o obj/dpi_rtl_sw.o obj/sysbus.o obj/dma_c_testbench.o
chmod +x src/syscalltbl.sh
src/syscalltbl.sh src/syscall.tbl src/syscalltbl.lst
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/cpu.c -o obj/cpu.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/mem.c -o obj/mem.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/loader.c -o obj/loader.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/queue.c -o obj/queue.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/os.c -o obj/os.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/sched.c -o obj/sched.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/timer.c -o obj/timer.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/mm-vm.c -o obj/mm-vm.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/mm64.c -o obj/mm64.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/mm.c -o obj/mm.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/mm-memphy.c -o obj/mm-memphy.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/libstd.c -o obj/libstd.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/libmem.c -o obj/libmem.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/syscall.c -o obj/syscall.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/sys_mem.c -o obj/sys_mem.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/sys_listsyscall.c -o obj/sys_listsyscall.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/sys_xxxhandler.c -o obj/sys_xxxhandler.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/dpi_rtl_sw.c -o obj/dpi_rtl_sw.o
gcc -Iinclude -std=gnu11 -c -g -DDMA_SW_FALLBACK src/sysbus.c -o obj/sysbus.o
g++ -iquote include -I/usr/share/verilator/include -I/usr/share/verilator/include/vltstd -std=gnu++14 -c -g -DDMA_SW_FALLBACK -DDEBUG_ENABLED=1 -DDMA_MAIN=0 src/dma_c_testbench.cpp -o obj/dma_c_testbench.o
g++ -Wall -g obj/cpu.o obj/mem.o obj/loader.o obj/queue.o obj/os.o obj/sched.o obj/timer.o obj/mm-vm.o obj/mm64.o obj/mm.o obj/mm-memphy.o obj/libstd.o obj/libmem.o obj/syscall.o obj/sys_mem.o obj/sys_listsyscall.o obj/sys_xxxhandler.o obj/dpi_rtl_sw.o obj/sysbus.o obj/dma_c_testbench.o -o os -lpthread -lpthread

